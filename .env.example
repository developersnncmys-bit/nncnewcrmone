# Copy to .env.local for local use. On Vercel add every variable in
# Project > Settings > Environment Variables.

# ---------- Database ----------
# Local:   mongodb://127.0.0.1:27017/multi_crm
# Vercel:  MongoDB Atlas, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nnc_crm
MONGODB_URI=mongodb://127.0.0.1:27017/multi_crm

# ---------- App / domains ----------
# Your marketing website (pricing, demo forms). The CRM app links back to it.
NEXT_PUBLIC_WEBSITE_URL=https://nncdigital.co.in
NEXT_PUBLIC_BRAND_NAME=NNC CRM
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain customers get subdomains on (abc.ROOT_DOMAIN). Include port in dev.
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# false = open CRMs at /w/<name> (easy local dev). true = real subdomains (production).
NEXT_PUBLIC_USE_SUBDOMAINS=false
# Production with subdomains: set to .yourcrm.com so login works on every subdomain
COOKIE_DOMAIN=

# ---------- Auth ----------
# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string
# Owner login. On a fresh database the first login with these creates the admin account.
SUPERADMIN_EMAIL=admin@yourcompany.com
SUPERADMIN_PASSWORD=change-me

# ---------- Razorpay (leave empty = test mode with simulated payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (leave SMTP_HOST empty = emails are only logged in /admin/emails) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NNC CRM <no-reply@yourcrm.com>"
# Gets an email for every new lead
ADMIN_EMAIL=

# ---------- Subscriptions ----------
# GST % added on top of plan prices (payments + invoices)
NEXT_PUBLIC_GST_RATE=18
GRACE_DAYS=7
REMINDER_DAYS=7,3,1
# Auto-run reminder job every N minutes on a normal Node server (VPS / PM2).
# On Vercel this is ignored: Vercel Cron calls /api/cron/billing daily (vercel.json).
BILLING_JOB_INTERVAL_MINUTES=60
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically
CRON_SECRET=change-me

# ---------- Invoice details ----------
COMPANY_ADDRESS=
COMPANY_GSTIN=

# ---------- Website lead API (POST /api/leads) ----------
# Websites allowed to send enquiries from the browser
LEAD_ALLOWED_ORIGINS=https://nncdigital.co.in,https://www.nncdigital.co.in,http://localhost:3001
